# Vonage API credentials — read-only usage, see README.md
#
# Both values are on the dashboard home page at https://dashboard.nexmo.com
# (top-left, under your account name).
#
# Vonage has no separately revocable read-only key, so this is the account's own
# secret. Rotate it in the dashboard once the migration is done.
VONAGE_API_KEY=abcd1234
VONAGE_API_SECRET=your_api_secret
