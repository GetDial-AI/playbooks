# Reference only: Pipecat Cloud doesn't read this file. These are the keys to put
# in the secret set named in pcc-deploy.toml — either one by one on the command
# line, or all at once from a filled-in copy of this file:
#   pipecat cloud secrets set dial-voice-agent-secrets --file .env --region us-west
# The Pipecat Cloud public key (pk_...) does NOT go here: it belongs to Dial's
# Self-Hosted config, not to the bot.

# Speech-to-text.
DEEPGRAM_API_KEY=""

# The LLM driving the conversation.
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4.1

# Text-to-speech.
CARTESIA_API_KEY=""
CARTESIA_VOICE_ID=86e30c1d-714b-4074-a1f2-1cb6b552fb49
