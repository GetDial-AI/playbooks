# Port the WebSocket server listens on (ngrok tunnels to this).
PORT=8080

# The signing secret for your Self-Hosted *audio* config, shown once when you
# save it. Used to verify X-Dial-Signature on every incoming connection.
DIAL_SIGNING_SECRET=""

# Speech-to-text.
DEEPGRAM_API_KEY=""

# The LLM driving the conversation.
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4.1

# Text-to-speech.
CARTESIA_API_KEY=""
CARTESIA_VOICE_ID=86e30c1d-714b-4074-a1f2-1cb6b552fb49
