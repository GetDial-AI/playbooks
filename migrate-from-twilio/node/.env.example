# Twilio credentials — read-only usage, see README.md
#
# Preferred: an API Key (SK…) + secret, created at
# https://console.twilio.com/us1/account/keys-credentials/api-keys
# It can be deleted after the migration without rotating the account.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_key_secret

# Alternative: the account's main auth token (less preferred — not separately revocable).
# TWILIO_AUTH_TOKEN=your_auth_token
